# ============================================================================
# AtlanTech Shop — Variables d'environnement
# ============================================================================
# Copier ce fichier vers .env puis remplir avec les vraies valeurs.
# Ne JAMAIS commiter le fichier .env (il est dans .gitignore).
# ============================================================================

# ----------------------------------------------------------------------------
# Base de données MySQL
# ----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=atldb
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ----------------------------------------------------------------------------
# URL du site (utilisé pour les redirections, emails, etc.)
# ----------------------------------------------------------------------------
SITE_URL=http://localhost/atlantech-shop

# ----------------------------------------------------------------------------
# Environnement : development | production
#   - development : affiche les erreurs PHP
#   - production  : masque les erreurs (recommandé en ligne)
# ----------------------------------------------------------------------------
APP_ENV=development

# ----------------------------------------------------------------------------
# MonCash / Digicel
# ----------------------------------------------------------------------------
# En local et en test, garder sandbox. En production, passer a live.
MONCASH_MODE=sandbox
MONCASH_CLIENT_ID=
MONCASH_CLIENT_SECRET=
MONCASH_CAINFO=

# Configurer aussi l'URL de retour dans le dashboard MonCash business :
# http://localhost/atlantech-shop/moncash-return.php

# ----------------------------------------------------------------------------
# Email Gmail SMTP (PHPMailer)
# ----------------------------------------------------------------------------
# Utiliser un mot de passe d'application Google (pas le vrai mot de passe)
# → https://myaccount.google.com/apppasswords
GMAIL_USER=votre-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM_NAME=AtlanTech
