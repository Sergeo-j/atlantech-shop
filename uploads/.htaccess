# Dossier uploads — images seulement, jamais de PHP exécutable
Options -Indexes -ExecCGI
RemoveHandler .php .php3 .php4 .php5 .php7 .phtml .phar
AddType text/plain .php .php3 .php4 .php5 .php7 .phtml .phar

<FilesMatch "\.(php|php3|php4|php5|php7|phtml|phar|pl|py|cgi|sh)$">
    Require all denied
</FilesMatch>
